# ==============================================================================
# Oculus CLI Environment Variables Template
# https://github.com/oculus-security/oculus
# ==============================================================================

# Developer Token generated from Oculus UI -> Settings -> Developer Tokens
# Required for non-interactive / CI/CD environments.
OCULUS_TOKEN=ocx_live_your_token_here

# Backend API base URL including /api/v1
# Defaults to http://localhost:3000/api/v1 if unset
OCULUS_API_URL=http://localhost:3000/api/v1

# Default Workspace UUID for all commands
# Avoids passing --workspace flag repeatedly
OCULUS_WORKSPACE_ID=your_workspace_uuid_here

# Optional: Disable ANSI color codes (standard no-color.org support)
# NO_COLOR=1

