# Oculus CLI — Environment Variables
# Copy to .env in your project root and fill in values.
# Alternatively, persist values with: oculus config set <key> <value>
# Or pass them as CLI flags on every command.

# Developer token generated from Oculus Settings → Developer Tokens
# Format: ocx_live_<base64url>
OCULUS_TOKEN=ocx_live_...

# Base URL of your Oculus backend API (include /api/v1)
OCULUS_API_URL=http://localhost:3000/api/v1

# Workspace ID to use by default for findings, repo, and scan commands
OCULUS_WORKSPACE_ID=
